<mxfile host="Electron" agent="Rain docs" version="32.7.4">
  <diagram id="rain-architecture" name="Architecture">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1700" pageHeight="1100" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Rain architecture" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=20;fontStyle=1;fontColor=#1B2733;" vertex="1" parent="1">
          <mxGeometry x="640" y="22" width="420" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Hover any icon, box or line to see what it is and why we use it. As of 21 Nov 2026." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=10;fontColor=#66757F;" vertex="1" parent="1">
          <mxGeometry x="640" y="54" width="520" height="20" as="geometry" />
        </mxCell>
        <object id="front" label="&lt;b&gt;FRONTEND&lt;/b&gt;  &lt;span style=&quot;color:#66757F&quot;&gt;· the window you see&lt;/span&gt;" tooltip="&lt;b&gt;What it is&lt;/b&gt;&lt;br&gt;The Rain window: everything you see and type into. It opens on&lt;br&gt;a hotkey or from Windows Search, and stays loaded but paused&lt;br&gt;while hidden so it reopens instantly.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why we use it&lt;/b&gt;&lt;br&gt;It is kept separate from the backend so jobs keep running when&lt;br&gt;the window is closed, and a window crash cannot stop them.&lt;br&gt;Game mode closes it completely." what="The Rain window: everything you see and type into. It opens on a hotkey or from Windows Search, and stays loaded but paused while hidden so it reopens instantly." why="It is kept separate from the backend so jobs keep running when the window is closed, and a window crash cannot stop them. Game mode closes it completely.">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=24;html=1;whiteSpace=wrap;container=1;collapsible=0;recursiveResize=0;strokeColor=#C3CDD7;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontFamily=Segoe UI;fontSize=11;fontColor=#3D4B57;fillColor=#F5F8FA;" vertex="1" parent="1">
            <mxGeometry x="40" y="150" width="420" height="420" as="geometry" />
          </mxCell>
        </object>
        <object id="back" label="&lt;b&gt;BACKEND&lt;/b&gt;  &lt;span style=&quot;color:#66757F&quot;&gt;· always running, no window&lt;/span&gt;" tooltip="&lt;b&gt;What it is&lt;/b&gt;&lt;br&gt;A small background program that starts when you log in. It&lt;br&gt;does the real work: launching things, running and scheduling&lt;br&gt;jobs, watching your files and recording what happened.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why we use it&lt;/b&gt;&lt;br&gt;Something has to keep working when the window is closed, and&lt;br&gt;one owner has to be able to shut everything down for game&lt;br&gt;mode." what="A small background program that starts when you log in. It does the real work: launching things, running and scheduling jobs, watching your files and recording what happened." why="Something has to keep working when the window is closed, and one owner has to be able to shut everything down for game mode.">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=24;html=1;whiteSpace=wrap;container=1;collapsible=0;recursiveResize=0;strokeColor=#C3CDD7;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontFamily=Segoe UI;fontSize=11;fontColor=#3D4B57;fillColor=#F5F8FA;" vertex="1" parent="1">
            <mxGeometry x="640" y="150" width="420" height="420" as="geometry" />
          </mxCell>
        </object>
        <object id="runs" label="&lt;b&gt;WHAT RAIN RUNS AND WATCHES&lt;/b&gt;" tooltip="&lt;b&gt;What it is&lt;/b&gt;&lt;br&gt;Everything outside Rain that the backend starts, stops or&lt;br&gt;listens to.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why we use it&lt;/b&gt;&lt;br&gt;This is what you actually use Rain for: opening things, and&lt;br&gt;keeping an eye on things that run on their own." what="Everything outside Rain that the backend starts, stops or listens to." why="This is what you actually use Rain for: opening things, and keeping an eye on things that run on their own.">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=24;html=1;whiteSpace=wrap;container=1;collapsible=0;recursiveResize=0;strokeColor=#C3CDD7;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontFamily=Segoe UI;fontSize=11;fontColor=#3D4B57;fillColor=#F5F8FA;" vertex="1" parent="1">
            <mxGeometry x="1240" y="150" width="420" height="420" as="geometry" />
          </mxCell>
        </object>
        <object id="data" label="&lt;b&gt;WHERE YOUR DATA LIVES&lt;/b&gt;" tooltip="&lt;b&gt;What it is&lt;/b&gt;&lt;br&gt;The three places Rain keeps or reads information.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why we use it&lt;/b&gt;&lt;br&gt;Your personal data stays apart from the open-source app, and&lt;br&gt;your own notes stay in files you control." what="The three places Rain keeps or reads information." why="Your personal data stays apart from the open-source app, and your own notes stay in files you control.">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=24;html=1;whiteSpace=wrap;container=1;collapsible=0;recursiveResize=0;strokeColor=#C3CDD7;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontFamily=Segoe UI;fontSize=11;fontColor=#3D4B57;fillColor=#F5F8FA;" vertex="1" parent="1">
            <mxGeometry x="640" y="680" width="420" height="190" as="geometry" />
          </mxCell>
        </object>
        <object id="later" label="&lt;b&gt;LATER&lt;/b&gt;  &lt;span style=&quot;color:#66757F&quot;&gt;· not being built yet&lt;/span&gt;" tooltip="&lt;b&gt;What it is&lt;/b&gt;&lt;br&gt;Parts that are planned but on hold.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why we use it&lt;/b&gt;&lt;br&gt;The local, non-AI features come first. The backend is designed&lt;br&gt;so these can connect later without changing anything else." what="Parts that are planned but on hold." why="The local, non-AI features come first. The backend is designed so these can connect later without changing anything else.">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=24;html=1;whiteSpace=wrap;container=1;collapsible=0;recursiveResize=0;strokeColor=#C3CDD7;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontFamily=Segoe UI;fontSize=11;fontColor=#3D4B57;fillColor=none;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
            <mxGeometry x="1240" y="680" width="420" height="190" as="geometry" />
          </mxCell>
        </object>
        <object id="you" label="&lt;b&gt;You&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#66757F&quot;&gt;keyboard first&lt;/span&gt;" tooltip="&lt;b&gt;What it is&lt;/b&gt;&lt;br&gt;How you bring Rain up: a global hotkey, the Windows Search bar&lt;br&gt;or Start menu, or the taskbar. Rain installs like any other&lt;br&gt;Windows app.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why we use it&lt;/b&gt;&lt;br&gt;It has to feel like part of the PC. After game mode nothing of&lt;br&gt;Rain is running, so Windows Search is also how you bring it&lt;br&gt;back." what="How you bring Rain up: a global hotkey, the Windows Search bar or Start menu, or the taskbar. Rain installs like any other Windows app." why="It has to feel like part of the PC. After game mode nothing of Rain is running, so Windows Search is also how you bring it back.">
          <mxCell style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;fontFamily=Segoe UI;fontSize=11;fontColor=#1B2733;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
            <mxGeometry x="228" y="30" width="44" height="44" as="geometry" />
          </mxCell>
        </object>
        <object id="vue" label="&lt;b&gt;Vue 3&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#66757F&quot;&gt;UI framework&lt;/span&gt;" tooltip="&lt;b&gt;What it is&lt;/b&gt;&lt;br&gt;The framework the frontend is written in. It turns data into&lt;br&gt;what you see on screen and updates only the parts that&lt;br&gt;changed.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why we use it&lt;/b&gt;&lt;br&gt;A small runtime, updates that stay smooth when job status and&lt;br&gt;logs change many times a second, and components that keep&lt;br&gt;markup, logic and style in one readable file." what="The framework the frontend is written in. It turns data into what you see on screen and updates only the parts that changed." why="A small runtime, updates that stay smooth when job status and logs change many times a second, and components that keep markup, logic and style in one readable file.">
          <mxCell style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;fontFamily=Segoe UI;fontSize=11;fontColor=#1B2733;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;spacingTop=3;" vertex="1" parent="front">
            <mxGeometry x="58" y="52" width="44" height="44" as="geometry" />
          </mxCell>
        </object>
        <object id="ts" label="&lt;b&gt;TypeScript&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#66757F&quot;&gt;typed JavaScript&lt;/span&gt;" tooltip="&lt;b&gt;What it is&lt;/b&gt;&lt;br&gt;JavaScript with types. The editor knows the shape of every&lt;br&gt;piece of data, so mistakes show up while writing code instead&lt;br&gt;of while running it.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why we use it&lt;/b&gt;&lt;br&gt;The frontend and backend exchange a lot of data. Types&lt;br&gt;generated from the backend's Rust code keep the two sides from&lt;br&gt;drifting apart." what="JavaScript with types. The editor knows the shape of every piece of data, so mistakes show up while writing code instead of while running it." why="The frontend and backend exchange a lot of data. Types generated from the backend's Rust code keep the two sides from drifting apart.">
          <mxCell style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;fontFamily=Segoe UI;fontSize=11;fontColor=#1B2733;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;spacingTop=3;" vertex="1" parent="front">
            <mxGeometry x="188" y="52" width="44" height="44" as="geometry" />
          </mxCell>
        </object>
        <object id="tailwind" label="&lt;b&gt;Tailwind CSS&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#66757F&quot;&gt;styling&lt;/span&gt;" tooltip="&lt;b&gt;What it is&lt;/b&gt;&lt;br&gt;A way to style the interface with short utility classes&lt;br&gt;written directly on each element, instead of separate&lt;br&gt;stylesheet files.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why we use it&lt;/b&gt;&lt;br&gt;One shared set of spacing, colour and type values keeps the&lt;br&gt;look consistent, and it is what shadcn-vue components are&lt;br&gt;built with." what="A way to style the interface with short utility classes written directly on each element, instead of separate stylesheet files." why="One shared set of spacing, colour and type values keeps the look consistent, and it is what shadcn-vue components are built with.">
          <mxCell style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;fontFamily=Segoe UI;fontSize=11;fontColor=#1B2733;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;spacingTop=3;" vertex="1" parent="front">
            <mxGeometry x="318" y="52" width="44" height="44" as="geometry" />
          </mxCell>
        </object>
        <object id="shadcn" label="&lt;b&gt;shadcn-vue&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#66757F&quot;&gt;ready-made components&lt;/span&gt;" tooltip="&lt;b&gt;What it is&lt;/b&gt;&lt;br&gt;A set of well-built interface components (buttons, dialogs,&lt;br&gt;menus) that are copied into our own code instead of installed&lt;br&gt;as a locked package.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why we use it&lt;/b&gt;&lt;br&gt;We never hand-build a basic widget, and because the components&lt;br&gt;live in our repo, restyling them into Rain's own look is&lt;br&gt;ordinary editing." what="A set of well-built interface components (buttons, dialogs, menus) that are copied into our own code instead of installed as a locked package." why="We never hand-build a basic widget, and because the components live in our repo, restyling them into Rain's own look is ordinary editing.">
          <mxCell style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;fontFamily=Segoe UI;fontSize=11;fontColor=#1B2733;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;spacingTop=3;" vertex="1" parent="front">
            <mxGeometry x="58" y="172" width="44" height="44" as="geometry" />
          </mxCell>
        </object>
        <object id="lucide" label="&lt;b&gt;Lucide&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#66757F&quot;&gt;icon set&lt;/span&gt;" tooltip="&lt;b&gt;What it is&lt;/b&gt;&lt;br&gt;A large open-source icon set drawn in one consistent line&lt;br&gt;style. The generic icons in this diagram are Lucide icons.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why we use it&lt;/b&gt;&lt;br&gt;One icon pack covers the whole app, so nothing needs a&lt;br&gt;custom-drawn icon." what="A large open-source icon set drawn in one consistent line style. The generic icons in this diagram are Lucide icons." why="One icon pack covers the whole app, so nothing needs a custom-drawn icon.">
          <mxCell style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;fontFamily=Segoe UI;fontSize=11;fontColor=#1B2733;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;spacingTop=3;" vertex="1" parent="front">
            <mxGeometry x="188" y="172" width="44" height="44" as="geometry" />
          </mxCell>
        </object>
        <object id="tauri" label="&lt;b&gt;Tauri 2&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#66757F&quot;&gt;app shell&lt;/span&gt;" tooltip="&lt;b&gt;What it is&lt;/b&gt;&lt;br&gt;The shell around the frontend. It provides the real Windows&lt;br&gt;window, the tray icon, the installer and the Start menu entry.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why we use it&lt;/b&gt;&lt;br&gt;It is the lightest way to put a web-built interface in a&lt;br&gt;desktop window: installers of roughly 10 MB where Electron&lt;br&gt;apps are 100 MB or more. It is written in Rust like the&lt;br&gt;backend, and can build for Linux and Android later." what="The shell around the frontend. It provides the real Windows window, the tray icon, the installer and the Start menu entry." why="It is the lightest way to put a web-built interface in a desktop window: installers of roughly 10 MB where Electron apps are 100 MB or more. It is written in Rust like the backend, and can build for Linux and Android later.">
          <mxCell style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;fontFamily=Segoe UI;fontSize=11;fontColor=#1B2733;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;spacingTop=3;" vertex="1" parent="front">
            <mxGeometry x="58" y="292" width="44" height="44" as="geometry" />
          </mxCell>
        </object>
        <object id="webview" label="&lt;b&gt;WebView2&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#66757F&quot;&gt;draws the interface&lt;/span&gt;" tooltip="&lt;b&gt;What it is&lt;/b&gt;&lt;br&gt;The browser engine that already ships with Windows 11. Tauri&lt;br&gt;uses it to draw the frontend.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why we use it&lt;/b&gt;&lt;br&gt;Using the copy Windows already has is what keeps Rain small.&lt;br&gt;Electron apps each bundle their own copy of Chrome instead." what="The browser engine that already ships with Windows 11. Tauri uses it to draw the frontend." why="Using the copy Windows already has is what keeps Rain small. Electron apps each bundle their own copy of Chrome instead.">
          <mxCell style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;fontFamily=Segoe UI;fontSize=11;fontColor=#1B2733;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;spacingTop=3;" vertex="1" parent="front">
            <mxGeometry x="188" y="292" width="44" height="44" as="geometry" />
          </mxCell>
        </object>
        <object id="rust" label="&lt;b&gt;Rust&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#66757F&quot;&gt;backend language&lt;/span&gt;" tooltip="&lt;b&gt;What it is&lt;/b&gt;&lt;br&gt;The programming language the backend and the Tauri shell are&lt;br&gt;written in. It compiles straight to machine code and has no&lt;br&gt;garbage collector or runtime running alongside the program.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why we use it&lt;/b&gt;&lt;br&gt;An idle Rust program typically uses a few megabytes and no&lt;br&gt;CPU, which is what an always-on backend needs. The compiler&lt;br&gt;also rejects whole classes of crashes before the program ever&lt;br&gt;runs." what="The programming language the backend and the Tauri shell are written in. It compiles straight to machine code and has no garbage collector or runtime running alongside the program." why="An idle Rust program typically uses a few megabytes and no CPU, which is what an always-on backend needs. The compiler also rejects whole classes of crashes before the program ever runs.">
          <mxCell style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;fontFamily=Segoe UI;fontSize=11;fontColor=#1B2733;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;spacingTop=3;" vertex="1" parent="back">
            <mxGeometry x="58" y="70" width="44" height="44" as="geometry" />
          </mxCell>
        </object>
        <object id="tokio" label="&lt;b&gt;Tokio&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#66757F&quot;&gt;async runtime&lt;/span&gt;" tooltip="&lt;b&gt;What it is&lt;/b&gt;&lt;br&gt;The runtime the backend runs on. It lets one small program&lt;br&gt;handle many things at once (requests, timers, file watching,&lt;br&gt;child processes) without a thread for each.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why we use it&lt;/b&gt;&lt;br&gt;It is the standard async runtime for Rust. A program built on&lt;br&gt;it sleeps until something happens, which keeps an always-on&lt;br&gt;backend near zero CPU." what="The runtime the backend runs on. It lets one small program handle many things at once (requests, timers, file watching, child processes) without a thread for each." why="It is the standard async runtime for Rust. A program built on it sleeps until something happens, which keeps an always-on backend near zero CPU.">
          <mxCell style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;fontFamily=Segoe UI;fontSize=11;fontColor=#1B2733;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;spacingTop=3;" vertex="1" parent="back">
            <mxGeometry x="188" y="70" width="44" height="44" as="geometry" />
          </mxCell>
        </object>
        <object id="axum" label="&lt;b&gt;axum&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#66757F&quot;&gt;web framework&lt;/span&gt;" tooltip="&lt;b&gt;What it is&lt;/b&gt;&lt;br&gt;The backend's web framework. It defines the REST API's routes&lt;br&gt;and the code that handles each request, the way Express or&lt;br&gt;FastAPI would.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why we use it&lt;/b&gt;&lt;br&gt;It is the mainstream Rust choice, maintained by the Tokio&lt;br&gt;team, and it is small: only what Rain uses gets compiled in.&lt;br&gt;The plan is to serve it over the named pipe instead of a&lt;br&gt;network port." what="The backend's web framework. It defines the REST API's routes and the code that handles each request, the way Express or FastAPI would." why="It is the mainstream Rust choice, maintained by the Tokio team, and it is small: only what Rain uses gets compiled in. The plan is to serve it over the named pipe instead of a network port.">
          <mxCell style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;fontFamily=Segoe UI;fontSize=11;fontColor=#1B2733;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;spacingTop=3;" vertex="1" parent="back">
            <mxGeometry x="318" y="70" width="44" height="44" as="geometry" />
          </mxCell>
        </object>
        <object id="api" label="&lt;b&gt;REST API&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#66757F&quot;&gt;JSON over a named pipe&lt;/span&gt;" tooltip="&lt;b&gt;What it is&lt;/b&gt;&lt;br&gt;How the frontend talks to the backend: ordinary REST requests&lt;br&gt;with JSON bodies, plus a WebSocket for live updates such as&lt;br&gt;log lines. They travel over a named pipe, a private Windows&lt;br&gt;channel, instead of a localhost port.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why we use it&lt;/b&gt;&lt;br&gt;REST and JSON are the standard, readable choice. The named&lt;br&gt;pipe is locked to your Windows account, so a web page or&lt;br&gt;another device cannot reach a backend that is able to start&lt;br&gt;programs." what="How the frontend talks to the backend: ordinary REST requests with JSON bodies, plus a WebSocket for live updates such as log lines. They travel over a named pipe, a private Windows channel, instead of a localhost port." why="REST and JSON are the standard, readable choice. The named pipe is locked to your Windows account, so a web page or another device cannot reach a backend that is able to start programs.">
          <mxCell style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;fontFamily=Segoe UI;fontSize=11;fontColor=#1B2733;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;spacingTop=3;" vertex="1" parent="back">
            <mxGeometry x="58" y="240" width="44" height="44" as="geometry" />
          </mxCell>
        </object>
        <object id="sched" label="&lt;b&gt;Scheduler&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#66757F&quot;&gt;runs jobs on time&lt;/span&gt;" tooltip="&lt;b&gt;What it is&lt;/b&gt;&lt;br&gt;The part of the backend that starts jobs on a schedule or when&lt;br&gt;the PC is idle, and catches up on runs that were missed.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why we use it&lt;/b&gt;&lt;br&gt;Scheduled tasks move out of the Claude app and into Rain, so&lt;br&gt;their schedule, history and failures are all visible in one&lt;br&gt;place." what="The part of the backend that starts jobs on a schedule or when the PC is idle, and catches up on runs that were missed." why="Scheduled tasks move out of the Claude app and into Rain, so their schedule, history and failures are all visible in one place.">
          <mxCell style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;fontFamily=Segoe UI;fontSize=11;fontColor=#1B2733;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;spacingTop=3;" vertex="1" parent="back">
            <mxGeometry x="188" y="240" width="44" height="44" as="geometry" />
          </mxCell>
        </object>
        <object id="jobs" label="&lt;b&gt;Job Objects&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#66757F&quot;&gt;stop whole process trees&lt;/span&gt;" tooltip="&lt;b&gt;What it is&lt;/b&gt;&lt;br&gt;A Windows feature: a container for processes. Anything started&lt;br&gt;inside it, and anything those processes start, stays in the&lt;br&gt;container.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why we use it&lt;/b&gt;&lt;br&gt;Stopping a job stops its entire process tree, with no orphans&lt;br&gt;left holding ports or memory. That is what lets game mode&lt;br&gt;leave nothing behind." what="A Windows feature: a container for processes. Anything started inside it, and anything those processes start, stays in the container." why="Stopping a job stops its entire process tree, with no orphans left holding ports or memory. That is what lets game mode leave nothing behind.">
          <mxCell style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;fontFamily=Segoe UI;fontSize=11;fontColor=#1B2733;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;spacingTop=3;" vertex="1" parent="back">
            <mxGeometry x="318" y="240" width="44" height="44" as="geometry" />
          </mxCell>
        </object>
        <object id="launch" label="&lt;b&gt;Launchables&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#66757F&quot;&gt;apps, pools, projects&lt;/span&gt;" tooltip="&lt;b&gt;What it is&lt;/b&gt;&lt;br&gt;Things Rain opens and then lets go: apps, pools of apps, and&lt;br&gt;code projects with their dev environment.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why we use it&lt;/b&gt;&lt;br&gt;Opening things is what you do most, so it has to be the&lt;br&gt;fastest path: hotkey, a few letters, Enter. Closing Rain never&lt;br&gt;closes what it opened." what="Things Rain opens and then lets go: apps, pools of apps, and code projects with their dev environment." why="Opening things is what you do most, so it has to be the fastest path: hotkey, a few letters, Enter. Closing Rain never closes what it opened.">
          <mxCell style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;fontFamily=Segoe UI;fontSize=11;fontColor=#1B2733;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;spacingTop=3;" vertex="1" parent="runs">
            <mxGeometry x="103" y="70" width="44" height="44" as="geometry" />
          </mxCell>
        </object>
        <object id="games" label="&lt;b&gt;Game libraries&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#66757F&quot;&gt;Steam, Epic, your own&lt;/span&gt;" tooltip="&lt;b&gt;What it is&lt;/b&gt;&lt;br&gt;Your games from Steam, Epic and your own folders, read from&lt;br&gt;the files those launchers already keep on disk.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why we use it&lt;/b&gt;&lt;br&gt;One library across every store, with nothing to keep in sync&lt;br&gt;by hand. Knowing which games exist also tells Rain when one is&lt;br&gt;running." what="Your games from Steam, Epic and your own folders, read from the files those launchers already keep on disk." why="One library across every store, with nothing to keep in sync by hand. Knowing which games exist also tells Rain when one is running.">
          <mxCell style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;fontFamily=Segoe UI;fontSize=11;fontColor=#1B2733;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;spacingTop=3;" vertex="1" parent="runs">
            <mxGeometry x="273" y="70" width="44" height="44" as="geometry" />
          </mxCell>
        </object>
        <object id="claude" label="&lt;b&gt;Claude Code&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#66757F&quot;&gt;sessions report via hooks&lt;/span&gt;" tooltip="&lt;b&gt;What it is&lt;/b&gt;&lt;br&gt;Your Claude Code sessions, from the terminal or the desktop&lt;br&gt;app. Small hooks in Claude Code's settings tell the backend&lt;br&gt;when a session starts, works, waits for you or finishes.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why we use it&lt;/b&gt;&lt;br&gt;You want every session visible in one place. Hooks are the&lt;br&gt;supported way to get live status, so Rain listens instead of&lt;br&gt;guessing." what="Your Claude Code sessions, from the terminal or the desktop app. Small hooks in Claude Code's settings tell the backend when a session starts, works, waits for you or finishes." why="You want every session visible in one place. Hooks are the supported way to get live status, so Rain listens instead of guessing.">
          <mxCell style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;fontFamily=Segoe UI;fontSize=11;fontColor=#1B2733;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;spacingTop=3;" vertex="1" parent="runs">
            <mxGeometry x="103" y="240" width="44" height="44" as="geometry" />
          </mxCell>
        </object>
        <object id="work" label="&lt;b&gt;Workflows&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#66757F&quot;&gt;scheduled and compute jobs&lt;/span&gt;" tooltip="&lt;b&gt;What it is&lt;/b&gt;&lt;br&gt;Things Rain runs and keeps an eye on: scheduled jobs, headless&lt;br&gt;Claude runs, compute jobs, a project's dev servers. Each has a&lt;br&gt;status, logs and a history.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why we use it&lt;/b&gt;&lt;br&gt;Rain owns these processes, so it can show what is happening,&lt;br&gt;tell you when one fails, and stop them all cleanly for game&lt;br&gt;mode." what="Things Rain runs and keeps an eye on: scheduled jobs, headless Claude runs, compute jobs, a project's dev servers. Each has a status, logs and a history." why="Rain owns these processes, so it can show what is happening, tell you when one fails, and stop them all cleanly for game mode.">
          <mxCell style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;fontFamily=Segoe UI;fontSize=11;fontColor=#1B2733;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;spacingTop=3;" vertex="1" parent="runs">
            <mxGeometry x="273" y="240" width="44" height="44" as="geometry" />
          </mxCell>
        </object>
        <object id="sqlite" label="&lt;b&gt;SQLite&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#66757F&quot;&gt;machine history, stays local&lt;/span&gt;" tooltip="&lt;b&gt;What it is&lt;/b&gt;&lt;br&gt;A database that is just a library inside the backend and a&lt;br&gt;single file on disk. There is no database server to install or&lt;br&gt;keep running.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why we use it&lt;/b&gt;&lt;br&gt;It answers questions like which runs failed this week, adds&lt;br&gt;under 1 MB and costs nothing while idle. It holds only machine&lt;br&gt;history, so it can be rebuilt and never leaves this PC." what="A database that is just a library inside the backend and a single file on disk. There is no database server to install or keep running." why="It answers questions like which runs failed this week, adds under 1 MB and costs nothing while idle. It holds only machine history, so it can be rebuilt and never leaves this PC.">
          <mxCell style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;fontFamily=Segoe UI;fontSize=11;fontColor=#1B2733;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;spacingTop=3;" vertex="1" parent="data">
            <mxGeometry x="58" y="52" width="44" height="44" as="geometry" />
          </mxCell>
        </object>
        <object id="raindata" label="&lt;b&gt;rain-data&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#66757F&quot;&gt;your setup, as TOML files&lt;/span&gt;" tooltip="&lt;b&gt;What it is&lt;/b&gt;&lt;br&gt;A private folder of plain text files (TOML, a simple settings&lt;br&gt;format) that describe your setup: pools, projects, workflows&lt;br&gt;and habits.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why we use it&lt;/b&gt;&lt;br&gt;Rain the app is open source; your setup is not. A friend can&lt;br&gt;install Rain and point it at their own folder. Text files are&lt;br&gt;easy to read, edit by hand and track in git." what="A private folder of plain text files (TOML, a simple settings format) that describe your setup: pools, projects, workflows and habits." why="Rain the app is open source; your setup is not. A friend can install Rain and point it at their own folder. Text files are easy to read, edit by hand and track in git.">
          <mxCell style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;fontFamily=Segoe UI;fontSize=11;fontColor=#1B2733;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;spacingTop=3;" vertex="1" parent="data">
            <mxGeometry x="188" y="52" width="44" height="44" as="geometry" />
          </mxCell>
        </object>
        <object id="vault" label="&lt;b&gt;Obsidian vault&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#66757F&quot;&gt;your personal data&lt;/span&gt;" tooltip="&lt;b&gt;What it is&lt;/b&gt;&lt;br&gt;Your existing Obsidian notes. Daily notes hold your planning&lt;br&gt;and habit check marks. Rain reads them and draws its own&lt;br&gt;heatmap and views.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why we use it&lt;/b&gt;&lt;br&gt;Obsidian is already where you plan and it already syncs to&lt;br&gt;your phone, so it is the database for everything personal.&lt;br&gt;Nothing AI-generated is ever written there." what="Your existing Obsidian notes. Daily notes hold your planning and habit check marks. Rain reads them and draws its own heatmap and views." why="Obsidian is already where you plan and it already syncs to your phone, so it is the database for everything personal. Nothing AI-generated is ever written there.">
          <mxCell style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;fontFamily=Segoe UI;fontSize=11;fontColor=#1B2733;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;spacingTop=3;" vertex="1" parent="data">
            <mxGeometry x="318" y="52" width="44" height="44" as="geometry" />
          </mxCell>
        </object>
        <object id="github" label="&lt;b&gt;GitHub&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#66757F&quot;&gt;private backups&lt;/span&gt;" tooltip="&lt;b&gt;What it is&lt;/b&gt;&lt;br&gt;Where the git repos are backed up: the public Rain code, your&lt;br&gt;private rain-data and your private Obsidian vault.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why we use it&lt;/b&gt;&lt;br&gt;It is free, it versions every change, and it is the only cloud&lt;br&gt;the first version needs. Code and personal data sit in&lt;br&gt;separate repos." what="Where the git repos are backed up: the public Rain code, your private rain-data and your private Obsidian vault." why="It is free, it versions every change, and it is the only cloud the first version needs. Code and personal data sit in separate repos.">
          <mxCell style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;fontFamily=Segoe UI;fontSize=11;fontColor=#1B2733;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;spacingTop=3;" vertex="1" parent="1">
            <mxGeometry x="828" y="940" width="44" height="44" as="geometry" />
          </mxCell>
        </object>
        <object id="phone" label="&lt;b&gt;Phone&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#66757F&quot;&gt;Tailscale + ntfy&lt;/span&gt;" tooltip="&lt;b&gt;What it is&lt;/b&gt;&lt;br&gt;Your phone connecting to the backend over Tailscale, a private&lt;br&gt;network between your own devices, with ntfy sending push&lt;br&gt;notifications.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why we use it&lt;/b&gt;&lt;br&gt;Not being built yet. The backend is designed so a phone can&lt;br&gt;connect later." what="Your phone connecting to the backend over Tailscale, a private network between your own devices, with ntfy sending push notifications." why="Not being built yet. The backend is designed so a phone can connect later.">
          <mxCell style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;fontFamily=Segoe UI;fontSize=11;fontColor=#1B2733;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;spacingTop=3;" vertex="1" parent="later">
            <mxGeometry x="103" y="52" width="44" height="44" as="geometry" />
          </mxCell>
        </object>
        <object id="ai" label="&lt;b&gt;AI&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#66757F&quot;&gt;Claude API, MCP&lt;/span&gt;" tooltip="&lt;b&gt;What it is&lt;/b&gt;&lt;br&gt;AI features inside Rain, using the Claude API, and an MCP&lt;br&gt;server that would let a Claude session ask Rain questions or&lt;br&gt;give it commands.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why we use it&lt;/b&gt;&lt;br&gt;On hold by design. The local, non-AI features come first." what="AI features inside Rain, using the Claude API, and an MCP server that would let a Claude session ask Rain questions or give it commands." why="On hold by design. The local, non-AI features come first.">
          <mxCell style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;fontFamily=Segoe UI;fontSize=11;fontColor=#1B2733;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;spacingTop=3;" vertex="1" parent="later">
            <mxGeometry x="273" y="52" width="44" height="44" as="geometry" />
          </mxCell>
        </object>
        <object id="e_open" label="hotkey · Windows Search" tooltip="&lt;b&gt;What it is&lt;/b&gt;&lt;br&gt;Pressing the hotkey, or opening Rain from Windows Search,&lt;br&gt;shows the window. If nothing of Rain is running, it starts the&lt;br&gt;backend first.">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B6B7A;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontFamily=Segoe UI;fontSize=10;fontColor=#3D4B57;labelBackgroundColor=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;align=left;spacingLeft=8;" edge="1" parent="1" source="you" target="front">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </object>
        <object id="e_api" label="REST API + live updates&lt;br&gt;JSON over a named pipe" tooltip="&lt;b&gt;What it is&lt;/b&gt;&lt;br&gt;The frontend asks and the backend answers, using ordinary REST&lt;br&gt;requests with JSON. A WebSocket carries live updates such as&lt;br&gt;log lines.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why we use it&lt;/b&gt;&lt;br&gt;A named pipe is used instead of a localhost port so that only&lt;br&gt;your Windows account can reach the backend.">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B6B7A;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontFamily=Segoe UI;fontSize=10;fontColor=#3D4B57;labelBackgroundColor=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;startArrow=block;startFill=1;startSize=6;verticalAlign=bottom;spacingBottom=4;" edge="1" parent="1" source="front" target="back">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </object>
        <object id="e_runs" label="starts · stops · watches" tooltip="&lt;b&gt;What it is&lt;/b&gt;&lt;br&gt;The backend opens launchables, runs workflows inside Job&lt;br&gt;Objects, and reads the game launchers' files.">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B6B7A;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontFamily=Segoe UI;fontSize=10;fontColor=#3D4B57;labelBackgroundColor=none;exitX=1;exitY=0.219;exitDx=0;exitDy=0;entryX=0;entryY=0.219;entryDx=0;entryDy=0;verticalAlign=bottom;spacingBottom=4;" edge="1" parent="1" source="back" target="runs">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </object>
        <object id="e_hooks" label="hooks report in" tooltip="&lt;b&gt;What it is&lt;/b&gt;&lt;br&gt;Claude Code calls a small hook whenever a session starts,&lt;br&gt;works, waits for you or finishes. The hook passes that on to&lt;br&gt;the backend.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why we use it&lt;/b&gt;&lt;br&gt;It is the supported way to see every session live without&lt;br&gt;scraping files.">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B6B7A;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontFamily=Segoe UI;fontSize=10;fontColor=#3D4B57;labelBackgroundColor=none;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.624;entryDx=0;entryDy=0;verticalAlign=bottom;spacingBottom=4;" edge="1" parent="1" source="claude" target="back">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </object>
        <object id="e_data" label="reads · records" tooltip="&lt;b&gt;What it is&lt;/b&gt;&lt;br&gt;The backend reads your setup files and your vault, and records&lt;br&gt;machine history in SQLite.">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B6B7A;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontFamily=Segoe UI;fontSize=10;fontColor=#3D4B57;labelBackgroundColor=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;align=left;spacingLeft=8;" edge="1" parent="1" source="back" target="data">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </object>
        <object id="e_git" label="git push (setup and notes only)" tooltip="&lt;b&gt;What it is&lt;/b&gt;&lt;br&gt;rain-data and the Obsidian vault are each backed up to their&lt;br&gt;own private GitHub repo. SQLite is not; it stays on this PC.">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B6B7A;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontFamily=Segoe UI;fontSize=10;fontColor=#3D4B57;labelBackgroundColor=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;align=left;spacingLeft=8;" edge="1" parent="1" source="data" target="github">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </object>
        <object id="e_later" label="connects later" tooltip="&lt;b&gt;What it is&lt;/b&gt;&lt;br&gt;The phone and AI features will talk to the same backend,&lt;br&gt;through its own separate, authenticated connection.">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B6B7A;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontFamily=Segoe UI;fontSize=10;fontColor=#3D4B57;labelBackgroundColor=none;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.86;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;align=left;spacingLeft=8;" edge="1" parent="1" source="later" target="back">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </object>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>