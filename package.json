{
  "name": "rain",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:fixture": "node scripts/dev.mjs --fixture typical",
    "backend:start": "node scripts/backend.mjs start",
    "backend:stop": "node scripts/backend.mjs stop",
    "backend:restart": "node scripts/backend.mjs restart",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "tauri": "tauri",
    "types": "node scripts/types.mjs",
    "types:check": "node scripts/types.mjs --check",
    "types:barrel": "node scripts/barrel.mjs",
    "test": "vitest run",
    "test:rust": "cargo test --workspace",
    "check": "node scripts/check.mjs",
    "smoke": "node scripts/smoke.mjs",
    "install:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install.ps1",
    "idle": "node scripts/idle.mjs",
    "frontend-checks": "node scripts/frontend-checks.mjs",
    "types:identity": "tsc -p crates/rain-types/tscheck"
  },
  "dependencies": {
    "@lucide/vue": "^1.77.0",
    "@tauri-apps/api": "^2.12.5",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "d3-hierarchy": "^3.1.3",
    "reka-ui": "^2.11.0",
    "simple-icons": "^16.38.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.6",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/tsconfig": "^0.9.1",
    "shadcn-vue": "^2.9.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  }
}
